#!/usr/bin/env bash
# SessionStart hook for paper-distill plugin
# Injects lightweight Paper Distill workflow routing context

set -euo pipefail

# Escape for JSON
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context_text="You have Paper Distill v3 installed. Use the medium-grained workflow skills when relevant: paper-distill:paper-intake for discover, inbox, ingest, and distill workflows; paper-distill:knowledge-workbench for QMD CLI read/index work plus upsert, merge, and lint workflows; paper-distill:idea-workbench for insights, ideas, and conversations. For read/index details, check docs/qmd-cli.md and runtime qmd --help."
context=$(escape_for_json "$(printf '<IMPORTANT>\n%s\n</IMPORTANT>' "$context_text")")

# Output for Claude Code
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$context"
fi

exit 0
