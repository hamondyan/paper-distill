#!/usr/bin/env bash
# SessionStart hook for paper-distill plugin
# Injects lightweight Paper Distill workflow routing context

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$("${SCRIPT_DIR}/../scripts/plugin-root.sh")"

# Escape for JSON
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

fallback_context_text="You have Paper Distill v3 installed. Use paper-intake for discover, approve, and ingest; paper-distillation for captured evidence; knowledge-workbench for QMD reads, writes, merges, and lint; idea-workbench for insights; qmd-reference for QMD syntax."
context_text="$(
    python3 "${REPO_ROOT}/server/agent_capabilities.py" 2>/dev/null \
        || printf '%s\n' "${fallback_context_text}"
)"
context=$(escape_for_json "$(printf '<IMPORTANT>\n%s\n</IMPORTANT>' "$context_text")")

# Output for Claude Code
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$context"
fi

exit 0
